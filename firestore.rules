rules_version = '2';

// Security rules IndahCell Stock.
//
// Struktur data:
//   stores/{storeId}/items/{itemId}
//   stores/{storeId}/history/{logId}
//
// storeId = device ID yang dibuat acak 20 karakter (lihat src/lib/device.ts).
// Device yang tahu storeId bisa baca/tulis. Device ID hanya dibagikan manual
// antar device milik toko yang sama, tidak pernah dipublikasikan.
//
// Catatan: ini BUKAN autentikasi penuh. Untuk aplikasi stok konter kecil ini
// memadai dan tidak butuh billing. Kalau nanti butuh keamanan lebih, tinggal
// aktifkan Firebase Auth dan ganti kondisi di bawah.

service cloud.firestore {
  match /databases/{database}/documents {

    // Panjang storeId harus wajar (20 karakter + 4 tanda hubung = 24).
    // Ini mencegah orang mencoba storeId pendek yang mudah ditebak.
    function validStoreId(storeId) {
      return storeId is string
             && storeId.size() >= 19
             && storeId.size() <= 32;
    }

    match /stores/{storeId}/{document=**} {
      allow read, write: if validStoreId(storeId);
    }

    // Tolak semua akses lain
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
